# Halt & Charge Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real passwords or secrets to Git!

# ==============================================================================
# Supabase PostgreSQL Database (from Supabase Dashboard -> Connect -> Session Pooler)
# ==============================================================================
PGHOST=aws-0-[region].pooler.supabase.com
PGPORT=6543
PGDATABASE=postgres
PGUSER=postgres.[your-project-ref]
PGPASSWORD=your-supabase-db-password

# ==============================================================================
# Security & JWT Configuration
# Generate a strong 256-bit key using: openssl rand -hex 32
# ==============================================================================
JWT_SECRET=your-minimum-32-character-secret-key-placeholder-here

# ==============================================================================
# Spring Profile & CORS
# ==============================================================================
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://your-customer-website.up.railway.app,https://your-admin-dashboard.up.railway.app

