# Multi-stage build for Halt & Charge Customer Website (React + Vite)
FROM node:20-alpine AS build
WORKDIR /app

COPY customer-website/package*.json ./
RUN npm install

COPY customer-website/ ./
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# Nginx production serving
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY customer-website/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

